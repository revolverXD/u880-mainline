--- a/sound/soc/codecs/aw88261.c	2026-10-18 21:48:45.873655789 +0000
+++ b/sound/soc/codecs/aw88261.c	2026-10-18 22:23:02.906023027 +0000
@@ -9,6 +9,7 @@

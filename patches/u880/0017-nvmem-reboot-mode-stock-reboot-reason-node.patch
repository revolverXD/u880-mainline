+		nvmem_rbm->cell = devm_nvmem_cell_get(&pdev->dev, "restart_reason");
 	if (IS_ERR(nvmem_rbm->cell)) {
 		return dev_err_probe(&pdev->dev, PTR_ERR(nvmem_rbm->cell),

diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..e9713b1 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -277,3 +277,80 @@ int hexagonfs_fstat(struct hexagonfs_fd **fds, int fileno, struct stat *stats)
 
 	return fd->ops->stat(fd, stats);
 }
+
+/* U880: writable host files for the sensors registry. */
+#include <stdint.h>
+#include <unistd.h>
+
+static void host_close(void *fd_data)
+{
+	close((int) (intptr_t) fd_data);
+}
+
+static ssize_t host_read(struct hexagonfs_fd *fd, size_t size, void *ptr)
+{
+	ssize_t ret = read((int) (intptr_t) fd->data, ptr, size);
+
+	return ret < 0 ? -errno : ret;
+}
+
+static ssize_t host_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	ssize_t ret = write((int) (intptr_t) fd->data, ptr, size);
+
+	return ret < 0 ? -errno : ret;
+}
+
+static int host_seek(struct hexagonfs_fd *fd, off_t off, int whence)
+{
+	off_t ret = lseek((int) (intptr_t) fd->data, off, whence);
+
+	return ret < 0 ? -errno : 0;
+}
+
+static int host_stat(struct hexagonfs_fd *fd, struct stat *stats)
+{
+	return fstat((int) (intptr_t) fd->data, stats) ? -errno : 0;
+}
+
+static struct hexagonfs_file_ops host_ops = {
+	.close = host_close,
+	.read = host_read,
+	.write = host_write,
+	.seek = host_seek,
+	.stat = host_stat,
+};
+
+int hexagonfs_open_host(struct hexagonfs_fd **fds, int hostfd)
+{
+	struct hexagonfs_fd *fd;
+	int ret;
+
+	fd = malloc(sizeof(struct hexagonfs_fd));
+	if (fd == NULL)
+		return -ENOMEM;
+	fd->is_assigned = false;
+	fd->up = NULL;
+	fd->data = (void *) (intptr_t) hostfd;
+	fd->ops = &host_ops;
+	ret = allocate_file_number(fds, fd);
+	if (ret < 0) {
+		free(fd);
+		return ret;
+	}
+	return ret;
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+	if (fd->ops->write == NULL)
+		return -EROFS;
+	return fd->ops->write(fd, size, ptr);
+}

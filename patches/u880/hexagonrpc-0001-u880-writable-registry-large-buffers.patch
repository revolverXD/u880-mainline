+static int u880_rw_path(const char *name, char *path, size_t size)
+{
+	static const char *const prefixes[] = { "/mnt/vendor/persist/sensors/", "/persist/sensors/" };
+	const char *rel = NULL, *rw_root = getenv("HEXAGONRPCD_PERSIST_RW");
+	size_t i;
+
+	for (i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++)
+		if (!strncmp(name, prefixes[i], strlen(prefixes[i])))
+			rel = name + strlen(prefixes[i]);
+	if (rw_root == NULL || rel == NULL || *rel == 0 || strstr(rel, "..") != NULL)
+		return -1;
+	if (snprintf(path, size, "%s/%s", rw_root, rel) >= (int) size)
+		return -1;
+	return 0;

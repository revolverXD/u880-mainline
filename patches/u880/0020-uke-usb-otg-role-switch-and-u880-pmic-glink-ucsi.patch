+	/*
+	 * U880 (sm7675-dwc3): the eUSB2 PHY and repeater are configured differently for host and device (U880_PHY_HOST_MODE),
+	 * so flip the flag and re-run the PHY init on every role change. The core soft-resets afterwards.
+	 */
+	if (qcom->uke && dwc->usb2_phy && (next_role == USB_ROLE_HOST || next_role == USB_ROLE_DEVICE)) {
+		usb_phy_shutdown(dwc->usb2_phy);
+		if (next_role == USB_ROLE_HOST)
+			dwc->usb2_phy->flags |= U880_PHY_HOST_MODE;
+		else
+			dwc->usb2_phy->flags &= ~U880_PHY_HOST_MODE;
+		if (usb_phy_init(dwc->usb2_phy))
+			dev_warn(qcom->dev, "USB2 PHY re-init for role %d failed\n", next_role);
+	}
+
 	if (pm_runtime_resume_and_get(qcom->dev)) {

# U880 overrides on top of defconfig + uke arm64-qcom.config + uke.config (built-in, no modules in our initramfs)
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_G_SERIAL=n
# CDC composite gadget: ACM serial (ttyGS0) + ECM ethernet (usb0) for rootfs transfer and ssh
CONFIG_USB_CDC_COMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_OBEX=y
CONFIG_USB_PHY_QCOM_UKE=y
CONFIG_USB_REPEATER_QCOM_UKE=n   # its PMIC repeater node appears with SPMI; must not retune our only USB link
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
# Display: simpledrm on the firmware framebuffer (root /framebuffer@e3940000 node) -> KMS device for compositors;
# fbcon via DRM fbdev emulation. (Stage 1 used FB_SIMPLE.)
CONFIG_FB_SIMPLE=n
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=n
CONFIG_PSTORE_PMSG=y
# GPU (Adreno 732): msm render node built in (cmdline msm.separate_gpu_kms=1, no DPU/DSI use yet), Cliffs GPU clocks
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_UBWC_CONFIG=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_MSM=y
CONFIG_SM_GPUCC_CLIFFS=y
# pacman 7 download sandbox needs Landlock
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
# Touch: Novatek NT36523N (I2C @0x01 on QUP0 SE4), mainline driver + patches/u880/0002
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS=y
# GPIO 128 (touch reset) is also referenced by ABL's downstream novatek@62 node -> gpiolib "shared" proxy needed
CONFIG_GPIO_SHARED_PROXY=y
# PMIC (SPMI) built-in: PON power key / volume down, RTC, temp alarms, SDAM, LPG PWM + pwm-backlight
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_PWM=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_QCOM_PBS=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_USB_GADGET_VBUS_DRAW=500
CONFIG_UHID=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_SND_SOC_AW88261=m
CONFIG_USB_REPEATER_QCOM_UKE=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_VFAT_FS=m
CONFIG_FAT_DEFAULT_UTF8=y

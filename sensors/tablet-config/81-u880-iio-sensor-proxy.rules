# U880: accelerometer (and light/compass) via the ADSP sensors core (libssc over QRTR; hexagonrpcd serves its registry).
# Mount matrix: the SSC reports the panel-up portrait pose as bottom-up -> invert X and Y.
SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp*", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel", ENV{ACCEL_MOUNT_MATRIX}="-1, 0, 0; 0, -1, 0; 0, 0, 1"

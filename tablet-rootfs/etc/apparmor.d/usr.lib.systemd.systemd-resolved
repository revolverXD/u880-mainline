abi <abi/4.0>,

include <tunables/global>

# Local DNS stub / LLMNR / mDNS responder. Network-facing; writes only /run/systemd/resolve.
/usr/lib/systemd/systemd-resolved flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>

  capability net_bind_service,
  capability net_raw,
  capability net_admin,
  capability setgid,
  capability setuid,

  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,
  network netlink raw,
  network unix dgram,
  network unix stream,

  unix,
  dbus,

  /usr/lib/systemd/systemd-resolved mr,
  /etc/hosts r,
  /etc/systemd/resolved.conf r,
  /etc/systemd/resolved.conf.d/ r,
  /etc/systemd/resolved.conf.d/** r,
  /etc/resolv.conf r,
  /etc/machine-id r,
  /etc/hostname r,
  /usr/lib/systemd/resolved.conf.d/** r,
  /run/systemd/resolve.hook/ r,
  /run/systemd/netif/** r,
  /run/systemd/resolve/ rw,
  /run/systemd/resolve/** rwk,
  /run/systemd/network/** r,
  @{PROC}/cmdline r,
  @{PROC}/pressure/* rw,
  @{PROC}/sys/kernel/hostname r,
  @{PROC}/sys/kernel/osrelease r,
  @{PROC}/sys/kernel/random/boot_id r,
  @{PROC}/sys/net/ipv6/conf/** r,
  @{PROC}/*/cgroup r,
}

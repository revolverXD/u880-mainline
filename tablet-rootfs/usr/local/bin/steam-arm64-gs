#!/bin/sh
# Native ARM64 Steam inside gamescope (its own Xwayland draws the X11 pop-up menus that Denial does not). Extra arguments go to steam.
[ "$(stat -c %u "$XDG_RUNTIME_DIR" 2>/dev/null)" = "$(id -u)" ] || export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
exec gamescope -f -W 2560 -H 1600 -- /usr/local/bin/steam-arm64 -no-cef-sandbox -noverifyfiles "$@"

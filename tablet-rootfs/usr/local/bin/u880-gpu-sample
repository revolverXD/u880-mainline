#!/usr/bin/python3
# Root service: every 2 s write "<MHz> MHz  <busy>%  <temp>C" to /run/u880-gpu.txt for the KDE widget org.u880.gpumon (issue #9).
# Busy % = growth of the DRM fdinfo counter drm-engine-gpu (ns) of every client that has /dev/dri/render* open, per second.
# Cost control: the full /proc walk for GPU clients happens every 15 s, the 2 s ticks only read the known clients' fdinfo.
import os, time

DEV = "/sys/class/devfreq/3d00000.qcom,kgsl-3d0"
OUT = "/run/u880-gpu.txt"
HOT = 90.0   # the GPU cooling device is bound at 95 C (issue #9)


def rd(p):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return ""


def gpu_temp():
    t = []
    for z in os.listdir("/sys/class/thermal"):
        if z.startswith("thermal_zone") and rd(f"/sys/class/thermal/{z}/type").startswith("gpuss"):
            v = rd(f"/sys/class/thermal/{z}/temp")
            if v.lstrip("-").isdigit():
                t.append(int(v) / 1000)
    return max(t) if t else 0.0


def scan_pids():
    pids = []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            for fd in os.listdir(f"/proc/{p}/fd"):
                if os.readlink(f"/proc/{p}/fd/{fd}").startswith("/dev/dri/render"):
                    pids.append(p)
                    break
        except OSError:
            pass
    return pids


def client_ns(pids):
    """{(pid, drm-client-id): ns} for all render-node fds of these pids."""
    out = {}
    for p in pids:
        try:
            for fd in os.listdir(f"/proc/{p}/fd"):
                if not os.readlink(f"/proc/{p}/fd/{fd}").startswith("/dev/dri/render"):
                    continue
                cid = ns = None
                for line in open(f"/proc/{p}/fdinfo/{fd}"):
                    if line.startswith("drm-client-id:"):
                        cid = line.split()[1]
                    elif line.startswith("drm-engine-gpu:"):
                        ns = int(line.split()[1])
                if cid is not None and ns is not None:
                    out[(p, cid)] = ns
        except OSError:
            pass
    return out


pids, last_scan, prev, t_prev = [], 0.0, {}, time.monotonic()
while True:
    time.sleep(2)
    now = time.monotonic()
    if now - last_scan > 15:
        pids, last_scan = scan_pids(), now
    cur = client_ns(pids)
    used = sum(max(0, v - prev.get(k, v)) for k, v in cur.items())   # a new client counts from its second sample
    pct = min(100, round(100 * used / ((now - t_prev) * 1e9)))
    prev, t_prev = cur, now
    mhz = int(rd(f"{DEV}/cur_freq") or 0) // 1000000
    temp = gpu_temp()
    line = f"{mhz} MHz  {pct}%  {temp:.0f}°C" + ("  HOT" if temp >= HOT else "")
    with open(OUT + ".tmp", "w") as f:
        f.write(line + "\n")
    os.chmod(OUT + ".tmp", 0o644)
    os.replace(OUT + ".tmp", OUT)

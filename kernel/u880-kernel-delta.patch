+static int qcom_uke_smmu_alloc_context_bank(struct arm_smmu_domain *domain,
+		struct arm_smmu_device *smmu, struct device *dev, int start)
+{
+	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+	const __be32 *actlr;
+	int len, i, j;
+
+	if (qcom_uke_display_domain(smmu, dev)) {
+		if (!qcom_uke_display_actlr_matches(smmu))
+			return -EINVAL;
+		return __arm_smmu_alloc_bitmap(smmu->context_map, start, smmu->num_context_banks);
+	}
+	/* OEM Cliffs streams, including WLAN SID 0x1400 with SMR mask 1. */
+	if (!fwspec || !fwspec->num_ids)
+		return -EINVAL;
+	actlr = of_get_property(smmu->dev->of_node, "qcom,actlr", &len);
+	if (actlr && len % (3 * sizeof(u32)))
+		return -EINVAL;
+	for (i = 0; i < fwspec->num_ids; i++) {
+		u32 sid = fwspec->ids[i];
+		/* U880: ADSP audio (q6apm-dais) streams 0x1001/0x1061; the ACTLR table is only a prefetch tuning. */
+		bool audio = (FIELD_GET(ARM_SMMU_SMR_ID, sid) == 0x1001 ||
+			      FIELD_GET(ARM_SMMU_SMR_ID, sid) == 0x1061) &&
+			     of_device_is_compatible(smmu->dev->of_node, "qcom,sm7675-boot-smmu");
+
+		/* U880: ADSP FastRPC compute context banks (stock adsprpc-smd cb10-cb14), used by the sensors PD. */
+		u32 id = FIELD_GET(ARM_SMMU_SMR_ID, sid);
+		bool fastrpc = ((id >= 0x1003 && id <= 0x1007) || (id >= 0x1043 && id <= 0x1047) ||
+				id == 0x1067 || id == 0x1087) &&
+			       of_device_is_compatible(smmu->dev->of_node, "qcom,sm7675-boot-smmu");
+
+		if (audio || fastrpc)
+			continue;
+		if (sid != 0x40 && sid != 0xb6 &&
+		    !((sid == 0x60 || sid == 0xa3 || sid == 0x423 ||
+		       sid == 0x436 || sid == 0x11400 ||
+		       /* U880: microSD (sdhc_2), the root filesystem. */
+		       sid == 0x140) &&
+		      of_device_is_compatible(smmu->dev->of_node, "qcom,sm7675-boot-smmu")))
+			return dev_err_probe(dev, -EOPNOTSUPP, "outside Uke boot SMMU scope\n");
+		/* None of these streams has an ACTLR override in OEM Cliffs DT. */
+		for (j = 0; actlr && j < len / sizeof(u32); j += 3)
+			if (!((FIELD_GET(ARM_SMMU_SMR_ID, sid) ^ be32_to_cpu(actlr[j])) &
+			      ~be32_to_cpu(actlr[j + 1])))
+				return dev_err_probe(dev, -EOPNOTSUPP,
+						     "boot stream needs an ACTLR override\n");
+	}
+	return __arm_smmu_alloc_bitmap(smmu->context_map, start, smmu->num_context_banks);
+}

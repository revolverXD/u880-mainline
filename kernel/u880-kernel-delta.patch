@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/test.h>
+#include "rpmh-uke-config.h"
+
+static void rpmh_uke_tcs_bounds_test(struct kunit *test)
+{
+	/* Uke channel 0: ACTIVE 3, SLEEP 2, WAKE 2, FAST_PATH 1. */
+	KUNIT_EXPECT_TRUE(test, rpmh_uke_tcs_fits(0, 3, 8));
+	KUNIT_EXPECT_TRUE(test, rpmh_uke_tcs_fits(3, 2, 8));
+	KUNIT_EXPECT_TRUE(test, rpmh_uke_tcs_fits(5, 2, 8));
+	KUNIT_EXPECT_TRUE(test, rpmh_uke_tcs_fits(7, 1, 8));
+	/* A second channel must include the first channel's allocation. */
+	KUNIT_EXPECT_FALSE(test, rpmh_uke_tcs_fits(8, 1, 8));
+	KUNIT_EXPECT_TRUE(test, rpmh_uke_tcs_fits(12, 3, 16));
+	KUNIT_EXPECT_FALSE(test, rpmh_uke_tcs_fits(14, 2, 16));
+	KUNIT_EXPECT_FALSE(test, rpmh_uke_tcs_fits(0, 4, 16));
+	KUNIT_EXPECT_FALSE(test, rpmh_uke_tcs_fits(~0U, 1, ~0U));
+	KUNIT_EXPECT_FALSE(test, rpmh_uke_tcs_fits(1, ~0U, ~0U));
+}
+
+static struct kunit_case rpmh_uke_cases[] = {
+	KUNIT_CASE(rpmh_uke_tcs_bounds_test),
+	{}
+};
+
+static struct kunit_suite rpmh_uke_suite = {
+	.name = "rpmh-uke-config",
+	.test_cases = rpmh_uke_cases,
+};
+kunit_test_suite(rpmh_uke_suite);

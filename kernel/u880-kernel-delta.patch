+static bool gpu_cc_cliffs_proxy_active;
+
+static void gpu_cc_cliffs_vdd_release(void *data)
+{
+	struct device *dev = data;
+
+	if (gpu_cc_cliffs_proxy_active) {
+		if (clk_vdd_proxy_unvote(dev, &gpu_cc_cliffs_desc))
+			return;
+		gpu_cc_cliffs_proxy_active = false;
+	}
+	clk_regulator_deinit(&gpu_cc_cliffs_desc);
+}
+
+static int gpu_cc_cliffs_probe(struct platform_device *pdev)
+{
+	struct regmap *regmap;
+	int ret;
+
+	ret = clk_regulator_init(&pdev->dev, &gpu_cc_cliffs_desc);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(&pdev->dev, gpu_cc_cliffs_vdd_release, &pdev->dev);
+	if (ret)
+		return ret;
+
+	regmap = qcom_cc_map(pdev, &gpu_cc_cliffs_desc);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	/* Retain firmware PLLs and gate state until consumers own the clocks. */
+	ret = clk_vdd_proxy_vote(&pdev->dev, &gpu_cc_cliffs_desc);
+	if (ret)
+		return ret;
+
+	/* Without this the first GMU clk_set_rate() hits an unconfigured PLL: "Lucid PLL latch failed" (antigravity analysis). */
+	clk_lucid_ole_pll_configure(&gpu_cc_pll0, regmap, &gpu_cc_pll0_config);
+	clk_lucid_ole_pll_configure(&gpu_cc_pll1, regmap, &gpu_cc_pll1_config);
+
+	gpu_cc_cliffs_proxy_active = true;
+	ret = qcom_cc_really_probe(&pdev->dev, &gpu_cc_cliffs_desc, regmap);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register GPU CC clocks\n");
+		return ret;
+	}
+
+	dev_info(&pdev->dev, "Registered GPU CC clocks\n");
+
+	return ret;
+}
+
+static void gpu_cc_cliffs_sync_state(struct device *dev)
+{
+	if (clk_sync_state(dev)) {
+		dev_warn(dev, "boot clocks still await handoff; retaining voltage vote\n");
+		return;
+	}
+	if (gpu_cc_cliffs_proxy_active && !clk_vdd_proxy_unvote(dev, &gpu_cc_cliffs_desc))
+		gpu_cc_cliffs_proxy_active = false;
+}

+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _DRM_QCOM_UKE_O82_AVR_H
+#define _DRM_QCOM_UKE_O82_AVR_H
+
+#include <linux/math64.h>
+#include <drm/uke-o82-mode.h>
+
+/* Experimental request floor from the lowest OEM mode, not a VRR rating. */
+static inline int qcom_uke_o82_avr_lines(const struct drm_display_mode *mode,
+				      unsigned int min_hz)
+{
+	u64 lines;
+
+	if (min_hz < 30 || !qcom_uke_o82_mode(mode))
+		return -EINVAL;
+	lines = div64_u64((u64)mode->clock * 1000, (u64)mode->htotal * min_hz);
+	/* Floor keeps the longest frame at or above the requested minimum Hz. */
+	/* Retain an OEM base whose integer-kHz clock rounds below nominal Hz. */
+	if (lines + 1 == (u64)mode->vtotal)
+		lines = mode->vtotal;
+	if (lines < (u64)mode->vtotal || lines > 65535)
+		return -EINVAL;
+	return lines;
+}
+
+#endif
--- /dev/null
+++ b/include/drm/uke-o82-mode.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _DRM_QCOM_UKE_O82_MODE_H
+#define _DRM_QCOM_UKE_O82_MODE_H
+
+#include <linux/errno.h>
+#include <drm/drm_modes.h>
+
+/* Exact OEM VFP groups; board, panel and link admission remain the caller's job. */
+static inline int qcom_uke_o82_mode_group(const struct drm_display_mode *mode)
+{
+	int group = -EINVAL;
+
+	if (!mode || mode->hdisplay != 3200 || mode->vdisplay != 2136 ||
+	    mode->flags || mode->hskew || mode->vscan)
+		return -EINVAL;
+
+	switch (mode->clock) {
+	case 967428:
+		if (mode->htotal == 3490 &&
+		    (mode->vtotal == 2310 || mode->vtotal == 4620))
+			group = 0;
+		break;
+	case 1097712:
+		if (mode->htotal == 3300 && mode->vtotal == 2310)
+			group = 1;
+		break;
+	case 804988:
+		if (mode->htotal == 3872 &&
+		    (mode->vtotal == 2310 || mode->vtotal == 4158 ||
+		     mode->vtotal == 4331 || mode->vtotal == 6930))
+			group = 2;
+		break;
+	}
+	if (group < 0 || mode->hsync_start != mode->htotal - 64 ||
+	    mode->hsync_end != mode->htotal - 32 ||
+	    mode->vsync_start != mode->vtotal - 148 ||
+	    mode->vsync_end != mode->vtotal - 146)
+		return -EINVAL;
+	return group;
+}
+
+static inline bool qcom_uke_o82_mode(const struct drm_display_mode *mode)
+{
+	return qcom_uke_o82_mode_group(mode) >= 0;
+}
+
+/* Exact OEM timings share one physical link clock; callers gate board and DSC. */
+static inline bool qcom_uke_o82_live_change(const struct drm_display_mode *old,
+					const struct drm_display_mode *new_mode)
+{
+	int group = qcom_uke_o82_mode_group(old);
+
+	return group >= 0 && qcom_uke_o82_mode_group(new_mode) >= 0 &&
+		(old->clock != new_mode->clock || old->vtotal != new_mode->vtotal);
+}
+
+#endif

+/*
+ * U880 bring-up aid: snapshot of the bootloader's working display configuration (taken before the handoff resets MDSS)
+ * and the same registers live, for diffing. /sys/kernel/debug/u880-display/{boot,live}. Read "live" only while the
+ * display is on: these blocks are unclocked otherwise and an access can hang the SoC.
+ */
+static const struct { u32 phys, len; bool live_only; } u880_regions[] = {
+	{ 0xae36000, 0x300 }, { 0xae37000, 0x300 },	/* INTF1, INTF2 (catalog len) */
+	/* PP/DSC (and INTF with 0x400) were in the first attempt, which reset the SoC (2026-10-19). */
+	{ 0xae94000, 0x400 }, { 0xae95000, 0xa00 },	/* DSI0, PHY0 */
+	{ 0xae96000, 0x400 }, { 0xae97000, 0xa00 },	/* DSI1, PHY1 */
+	{ 0xaf08000, 0x300 },				/* dispcc RCGs (pclk 0x80a8/0x80c0, byte 0x8108/0x8124) */
+	/* DSC block: even a live read reset the SoC; use /sys/kernel/debug/dri/1/kms (catalog-sized dump) instead. */
+};
+static u32 *u880_boot_regs;
+
+static u32 *u880_snapshot(bool live)
+{
+	size_t total = 0, n = 0;
+	u32 *buf;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(u880_regions); i++)
+		total += u880_regions[i].len / 4;
+	buf = vmalloc(total * 4);
+	if (!buf)
+		return NULL;
+	for (i = 0; i < ARRAY_SIZE(u880_regions); i++) {
+		void __iomem *io;
+		u32 off;
+
+		if (u880_regions[i].live_only && !live) {
+			for (off = 0; off < u880_regions[i].len; off += 4)
+				buf[n++] = 0xdeadbeef;
+			continue;
+		}
+		io = ioremap(u880_regions[i].phys, u880_regions[i].len);
+
+		for (off = 0; off < u880_regions[i].len; off += 4)
+			buf[n++] = io ? readl(io + off) : 0xdeadbeef;
+		if (io)
+			iounmap(io);
+	}
+	return buf;
+}
+
+static int u880_regs_print(struct seq_file *m, u32 *buf)
+{
+	size_t n = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(u880_regions); i++) {
+		u32 off;
+
+		for (off = 0; off < u880_regions[i].len; off += 4, n++)
+			seq_printf(m, "%08x %08x\n", u880_regions[i].phys + off, buf[n]);
+	}
+	return 0;
+}
+
+static int u880_boot_show(struct seq_file *m, void *unused)
+{
+	return u880_boot_regs ? u880_regs_print(m, u880_boot_regs) : -ENODATA;
+}
+DEFINE_SHOW_ATTRIBUTE(u880_boot);
+
+static int u880_live_show(struct seq_file *m, void *unused)
+{
+	u32 *buf = u880_snapshot(true);
+
+	if (!buf)
+		return -ENOMEM;
+	u880_regs_print(m, buf);
+	vfree(buf);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(u880_live);

+++ b/drivers/gpu/drm/panel/panel-alldocube-u880.c
@@ -0,0 +1,453 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Alldocube iPlay 70 mini Ultra (U880) BOE 1600x2560 LCD, Novatek TDDI (NT36523N touch side).
+ * Dual DSI, C-PHY (3 trios per link), DSC 1.1 800x20 slices 8 bpc / 8 bpp, video burst mode.
+ * Timings, power and command sequences from the stock panel node "mdss_dsi_boe_144hz_U880_video".
+ * Structure based on panel-himax-hx83121a.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct u880_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi[2];
+	struct drm_dsc_config dsc;
+	struct regulator *vddio;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enp_gpio;
+	struct gpio_desc *enn_gpio;
+	u8 dcs_buf[16];
+	int dcs_len;
+};
+
+static inline struct u880_panel *to_u880_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct u880_panel, panel);
+}
+
+extern unsigned int u880_dbg;	/* msm bring-up switches (drivers/gpu/drm/msm/msm_drv.h) */
+extern unsigned int u880_dbg2;
+
+static void u880_dual_write(struct mipi_dsi_multi_context *lc0,
+			    struct mipi_dsi_multi_context *lc1,
+			    const void *data, size_t len)
+{
+	mipi_dsi_dcs_write_buffer_multi(lc0, data, len);
+	mipi_dsi_dcs_write_buffer_multi(lc1, data, len);
+}
+
+#define U880_DUAL_SEQ(lc0, lc1, seq...) do { \
+	static const u8 _d[] = { seq }; \
+	u880_dual_write(lc0, lc1, _d, ARRAY_SIZE(_d)); \
+} while (0)
+
+static void u880_dbg_status(struct u880_panel *ctx, int link, const char *when)
+{
+	u8 pm = 0xee, dg = 0xee;
+	ssize_t r1, r2;
+
+	if (!(u880_dbg & 0x40000000))
+		return;
+	r1 = mipi_dsi_dcs_read(ctx->dsi[link], 0x0a, &pm, 1);
+	r2 = mipi_dsi_dcs_read(ctx->dsi[link], 0x0f, &dg, 1);
+	dev_info(ctx->panel.dev, "status link%d %s: 0x0a=%zd:%02x 0x0f=%zd:%02x\n", link, when, r1, pm, r2, dg);
+}
+
+/* Power the panel down: the tail of unprepare, and the start of prepare when the bootloader left it on. */
+static void u880_power_off(struct u880_panel *ctx, bool cycle_rail)
+{
+	gpiod_direction_output(ctx->reset_gpio, 1);
+	gpiod_direction_output(ctx->enn_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_direction_output(ctx->enp_gpio, 0);
+	/*
+	 * unprepare holds a reference, so a plain disable is balanced. prepare holds none: _regulator_disable()
+	 * then refuses with -EIO ("unbalanced disables") and leaves the rail on, while regulator_force_disable()
+	 * leaves use_count set so the following regulator_enable() skips the hardware. Taking a reference and
+	 * dropping it again is the only balanced way to really cycle VDDIO.
+	 */
+	if (cycle_rail) {
+		if (!regulator_enable(ctx->vddio))
+			regulator_disable(ctx->vddio);
+	} else {
+		regulator_disable(ctx->vddio);
+	}
+}
+
+static int u880_prepare(struct drm_panel *panel)
+{
+	struct u880_panel *ctx = to_u880_panel(panel);
+	/* Bonded + sync: msm drops writes on DSI0 and broadcasts the ones sent on DSI1. */
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi[1] };
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	/*
+	 * U880: the bootloader leaves the panel powered, so the first regulator_enable() after boot is a no-op and
+	 * the two Novatek ICs never see a power-on reset. That is the boot lottery: a suspend/resume (which does
+	 * reach a real power-down) always fixes a bad first enable. Power down first when something already has it
+	 * on. u880_dbg2 & 0x20 turns this off again for A/B tests.
+	 */
+	if (!(u880_dbg2 & 0x20) && regulator_is_enabled(ctx->vddio) > 0) {
+		u880_power_off(ctx, true);
+		msleep(50);
+	}
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+	msleep(20);
+	gpiod_direction_output(ctx->enp_gpio, 1);
+	usleep_range(5000, 6000);
+	gpiod_direction_output(ctx->enn_gpio, 1);
+	usleep_range(10000, 11000);
+
+	/* stock qcom,mdss-dsi-reset-sequence: high 10 ms, low 10 ms, high 10 ms */
+	gpiod_direction_output(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_direction_output(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_direction_output(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	/* 0x10000000: per-link picture width in the PPS (vendor sends 800; the host config says 1600) */
+	if (u880_dbg & 0x10000000)
+		pps.pic_width = cpu_to_be16(800);
+	dev_info(panel->dev, "DSC %ux%u slice %ux%u chunk %u init_xmit %u init_dec %u scale_inc %u scale_dec %u first_bpg %u nfl_bpg %u slice_bpg %u final_off %u\n",
+		 ctx->dsc.pic_width, ctx->dsc.pic_height, ctx->dsc.slice_width, ctx->dsc.slice_height,
+		 ctx->dsc.slice_chunk_size, ctx->dsc.initial_xmit_delay, ctx->dsc.initial_dec_delay,
+		 ctx->dsc.scale_increment_interval, ctx->dsc.scale_decrement_interval,
+		 ctx->dsc.first_line_bpg_offset, ctx->dsc.nfl_bpg_offset, ctx->dsc.slice_bpg_offset,
+		 ctx->dsc.final_offset);
+	/* vendor order (dsi_display_enable): ON command set first, then the PPS, which overrides the Novatek 0x91 values */
+	{
+		/*
+		 * Lock-step dual-IC wakeup. The panel is two Novatek ICs; mainline's bonded broadcast sends the
+		 * commands once for both, and the pair only comes up reliably when each link is driven separately.
+		 * Send each init command to link0 then link1 interleaved (pair-by-pair),
+		 * then 0x11 sleep-out on both links back-to-back,
+		 * wait 100 ms once while BOTH Novatek ICs wake up and sync together,
+		 * re-assert user commands (0x35, 0x51, 0x53),
+		 * then 0x29 display-on on both links, then PPS on both links.
+		 */
+		struct mipi_dsi_multi_context lc0 = { .dsi = ctx->dsi[0] };
+		struct mipi_dsi_multi_context lc1 = { .dsi = ctx->dsi[1] };
+
+		U880_DUAL_SEQ(&lc0, &lc1, 0xff, 0xd0);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xfb, 0x01);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x00, 0x30);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x09, 0xee);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x1c, 0x99);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x1d, 0x09);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xff, 0xf0);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xfb, 0x01);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x24, 0x02);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xff, 0x2a);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xfb, 0x01);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xbc, 0x33, 0x03);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xff, 0x10);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xfb, 0x01);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x35, 0x00);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x3b, 0x03, 0x64, 0x1e, 0x04, 0x04, 0x00);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x51, 0x01, 0xff);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x53, 0x2c);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x55, 0x00);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x90, 0x03);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x91, 0x89, 0x08, 0x00, 0x14, 0xd2, 0x00, 0x02,
+			      0xb2, 0x02, 0x2b, 0x00, 0x0b, 0x05, 0x7a, 0x03, 0x68);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x92, 0x10, 0xe0);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xb2, 0x00);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xb3, 0x12);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xbb, 0x13);
+
+		mipi_dsi_dcs_exit_sleep_mode_multi(&lc0);
+		mipi_dsi_dcs_exit_sleep_mode_multi(&lc1);
+		msleep(100);
+
+		/* Re-assert user commands in case 0x11 sleep-out reset them on either IC */
+		U880_DUAL_SEQ(&lc0, &lc1, 0xff, 0x10);
+		U880_DUAL_SEQ(&lc0, &lc1, 0xfb, 0x01);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x35, 0x00);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x51, 0x01, 0xff);
+		U880_DUAL_SEQ(&lc0, &lc1, 0x53, 0x2c);
+
+		mipi_dsi_dcs_set_display_on_multi(&lc0);
+		mipi_dsi_dcs_set_display_on_multi(&lc1);
+		u880_dbg_status(ctx, 0, "lockstep-ON");
+		u880_dbg_status(ctx, 1, "lockstep-ON");
+		mipi_dsi_picture_parameter_set_multi(&lc0, &pps);
+		mipi_dsi_picture_parameter_set_multi(&lc1, &pps);
+		u880_dbg_status(ctx, 0, "lockstep-PPS");
+		u880_dbg_status(ctx, 1, "lockstep-PPS");
+		dsi_ctx.accum_err = lc0.accum_err ? lc0.accum_err : lc1.accum_err;
+	}
+	dev_info(panel->dev, "panel on sequence done: %d\n", dsi_ctx.accum_err);
+	/* 0x40000000: read panel status per link while the links are still in command mode (before video starts) */
+	if (u880_dbg & 0x40000000) {
+		static const u8 regs[] = { 0x0a, 0x0e, 0x0f, 0x90, 0x91, 0x92, 0xb2, 0xb3, 0xbb, 0x51, 0x53, 0x55 };
+		int i, j;
+
+		for (i = 0; i < 2; i++) {
+			struct mipi_dsi_multi_context lc = { .dsi = ctx->dsi[i] };
+			u8 cmd2_d0[4] = {};
+			/* Switch to page 0xd0 to verify CMD2 writes survived */
+			mipi_dsi_dcs_write_seq_multi(&lc, 0xff, 0xd0);
+			mipi_dsi_dcs_write_seq_multi(&lc, 0xfb, 0x01);
+			mipi_dsi_dcs_read(ctx->dsi[i], 0x00, &cmd2_d0[0], 1);
+			mipi_dsi_dcs_read(ctx->dsi[i], 0x09, &cmd2_d0[1], 1);
+			mipi_dsi_dcs_read(ctx->dsi[i], 0x1c, &cmd2_d0[2], 1);
+			mipi_dsi_dcs_read(ctx->dsi[i], 0x1d, &cmd2_d0[3], 1);
+			dev_info(panel->dev, "dcsread link%d page 0xd0 [00,09,1c,1d]: %*ph\n", i, 4, cmd2_d0);
+			/* Switch back to page 0x10 */
+			mipi_dsi_dcs_write_seq_multi(&lc, 0xff, 0x10);
+			mipi_dsi_dcs_write_seq_multi(&lc, 0xfb, 0x01);
+
+			for (j = 0; j < ARRAY_SIZE(regs); j++) {
+				u8 b[16] = {};
+				ssize_t r = mipi_dsi_dcs_read(ctx->dsi[i], regs[j], b, 4);
+
+				dev_info(panel->dev, "dcsread link%d reg 0x%02x: %zd %*ph\n", i, regs[j], r, 4, b);
+			}
+		}
+	}
+	if (dsi_ctx.accum_err) {
+		gpiod_direction_output(ctx->reset_gpio, 1);
+		regulator_disable(ctx->vddio);
+	}
+	return dsi_ctx.accum_err;
+}
+
+static int u880_unprepare(struct drm_panel *panel)
+{
+	struct u880_panel *ctx = to_u880_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi[1] };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 16);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+	if (dsi_ctx.accum_err)
+		dev_err(panel->dev, "panel off failed: %d\n", dsi_ctx.accum_err);
+
+	u880_power_off(ctx, false);
+	return 0;
+}
+
+/* Per link: 800 active, hfp 27, hsync 20, hbp 26; vfp 30, vsync 2, vbp 98 (stock timing@0, 144 Hz). */
+#define U880_HTOTAL ((800 + 27 + 20 + 26) * 2)
+#define U880_VTOTAL (2560 + 30 + 2 + 98)
+
+/*
+ * Stock dfps list is 144/120/90/60 Hz ("dfps_immediate_porch_mode_vfp"): only the vertical front porch grows, the pixel
+ * clock and the init sequence stay those of 144 Hz. vtotal = 2690 * 144 / rate gives the exact rates.
+ */
+#define U880_VTOTAL_AT(hz) (U880_VTOTAL * 144 / (hz))
+#define U880_MODE(hz, flags)						\
+{									\
+	.clock = U880_HTOTAL * U880_VTOTAL * 144 / 1000,		\
+	.hdisplay = 800 * 2,						\
+	.hsync_start = (800 + 27) * 2,					\
+	.hsync_end = (800 + 27 + 20) * 2,				\
+	.htotal = U880_HTOTAL,						\
+	.vdisplay = 2560,						\
+	.vsync_start = 2560 + 30 + U880_VTOTAL_AT(hz) - U880_VTOTAL,	\
+	.vsync_end = 2560 + 30 + 2 + U880_VTOTAL_AT(hz) - U880_VTOTAL,	\
+	.vtotal = U880_VTOTAL_AT(hz),					\
+	.width_mm = 118,						\
+	.height_mm = 190,						\
+	.type = DRM_MODE_TYPE_DRIVER | (flags),				\
+}
+
+static const struct drm_display_mode u880_modes[] = {
+	U880_MODE(144, DRM_MODE_TYPE_PREFERRED),
+	U880_MODE(120, 0),
+	U880_MODE(90, 0),
+	U880_MODE(60, 0),
+};
+
+static int u880_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(u880_modes); i++) {
+		struct drm_display_mode *mode = drm_mode_duplicate(connector->dev, &u880_modes[i]);
+
+		if (!mode)
+			break;
+		/* u880_dbg2 & 0x4: 60 Hz only, the old single-mode signal-integrity test */
+		if ((u880_dbg2 & 0x4) && drm_mode_vrefresh(mode) != 60) {
+			drm_mode_destroy(connector->dev, mode);
+			continue;
+		}
+		if ((u880_dbg2 & 0x4) || !i)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+		n++;
+	}
+	connector->display_info.width_mm = 118;
+	connector->display_info.height_mm = 190;
+	return n;
+}
+
+static const struct drm_panel_funcs u880_panel_funcs = {
+	.prepare = u880_prepare,
+	.unprepare = u880_unprepare,
+	.get_modes = u880_get_modes,
+};
+
+/* Bring-up aid: DCS get_power_mode (0x0a) from DSI1; the stock ESD check expects 0x9c. */
+static ssize_t power_mode_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct u880_panel *ctx = dev_get_drvdata(dev);
+	u8 mode = 0;
+	int ret = mipi_dsi_dcs_get_power_mode(ctx->dsi[1], &mode);
+
+	return ret ? ret : sysfs_emit(buf, "0x%02x\n", mode);
+}
+static DEVICE_ATTR_RO(power_mode);
+
+/*
+ * Bring-up aid: per-link DCS read (reads are not broadcast, so dsi[0] queries the panel's port 0 directly).
+ * echo "<link 0|1> <reg hex> <len 1..16>" > dcs_read; cat dcs_read -> hex bytes or the error.
+ */
+static ssize_t dcs_read_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct u880_panel *ctx = dev_get_drvdata(dev);
+	unsigned int link, reg, len;
+	int ret;
+
+	if (sscanf(buf, "%u %x %u", &link, &reg, &len) != 3 || link > 1 || reg > 0xff || !len ||
+	    len > sizeof(ctx->dcs_buf))
+		return -EINVAL;
+	ret = mipi_dsi_dcs_read(ctx->dsi[link], reg, ctx->dcs_buf, len);
+	ctx->dcs_len = ret;
+	return count;
+}
+
+static ssize_t dcs_read_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct u880_panel *ctx = dev_get_drvdata(dev);
+
+	if (ctx->dcs_len < 0)
+		return sysfs_emit(buf, "error %d\n", ctx->dcs_len);
+	return sysfs_emit(buf, "%*ph\n", ctx->dcs_len, ctx->dcs_buf);
+}
+static DEVICE_ATTR_RW(dcs_read);
+
+static const struct drm_dsc_config u880_dsc = {
+	.dsc_version_major = 1,
+	.dsc_version_minor = 1,
+	.slice_height = 20,
+	.slice_width = 800,
+	.slice_count = 1,
+	.bits_per_component = 8,
+	.bits_per_pixel = 8 << 4,
+	.block_pred_enable = true,
+};
+
+static int u880_probe(struct mipi_dsi_device *dsi)
+{
+	struct mipi_dsi_device_info dsi_info = { "dsi-secondary", 0, NULL };
+	struct device *dev = &dsi->dev;
+	struct mipi_dsi_host *dsi1_host;
+	struct device_node *dsi1;
+	struct u880_panel *ctx;
+	int ret, i;
+
+	ctx = devm_drm_panel_alloc(dev, struct u880_panel, panel, &u880_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(ctx->vddio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddio), "no vddio supply\n");
+	/* ASIS: the bootloader left the panel running; do not blank it before the first modeset. */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "no reset gpio\n");
+	ctx->enp_gpio = devm_gpiod_get(dev, "enp", GPIOD_ASIS);
+	if (IS_ERR(ctx->enp_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enp_gpio), "no enp gpio\n");
+	ctx->enn_gpio = devm_gpiod_get(dev, "enn", GPIOD_ASIS);
+	if (IS_ERR(ctx->enn_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enn_gpio), "no enn gpio\n");
+	ctx->dsc = u880_dsc;
+
+	dsi1 = of_graph_get_remote_node(dev->of_node, 1, -1);
+	if (!dsi1)
+		return dev_err_probe(dev, -ENODEV, "no secondary DSI node\n");
+	dsi1_host = of_find_mipi_dsi_host_by_node(dsi1);
+	of_node_put(dsi1);
+	if (!dsi1_host)
+		return dev_err_probe(dev, -EPROBE_DEFER, "secondary DSI host not ready\n");
+	ctx->dsi[1] = devm_mipi_dsi_device_register_full(dev, dsi1_host, &dsi_info);
+	if (IS_ERR(ctx->dsi[1]))
+		return dev_err_probe(dev, PTR_ERR(ctx->dsi[1]), "cannot register secondary DSI device\n");
+	mipi_dsi_set_drvdata(ctx->dsi[1], ctx);
+	ctx->dsi[0] = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->panel.prepare_prev_first = true;
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get backlight\n");
+	drm_panel_add(&ctx->panel);
+	device_create_file(dev, &dev_attr_power_mode);
+	device_create_file(dev, &dev_attr_dcs_read);
+
+	for (i = 0; i < 2; i++) {
+		ctx->dsi[i]->lanes = 3; /* C-PHY trios */
+		ctx->dsi[i]->format = MIPI_DSI_FMT_RGB888;
+		ctx->dsi[i]->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+					  MIPI_DSI_CLOCK_NON_CONTINUOUS | /* C-PHY: no clock lane */
+					  MIPI_DSI_MODE_LPM;
+		ctx->dsi[i]->dsc = &ctx->dsc;
+		ret = devm_mipi_dsi_attach(dev, ctx->dsi[i]);
+		if (ret < 0) {
+			drm_panel_remove(&ctx->panel);
+			return dev_err_probe(dev, ret, "failed to attach DSI%d\n", i);
+		}
+	}
+	return 0;
+}
+
+static void u880_remove(struct mipi_dsi_device *dsi)
+{

+/*
+ * U880 (C-PHY video panel): vendor dsi_display_handle_fifo_overflow(). A FIFO overflow leaves the lane transmitters
+ * stuck in LP-stop (DSI lane status 0x1f1f, Android 0x1f18). Recover like the vendor, for BOTH links together: video off,
+ * controller soft reset with the clocks forced on, PHY lane reset (LANE_CTRL3 0x1f -> 0), wait until the DPU interface
+ * line counter is in the active region, then video on again on both links.
+ */
+static struct msm_dsi_host *u880_hosts[2];
+static DEFINE_MUTEX(u880_recover_lock);
+
+/* Bring-up probe: /sys/kernel/debug/u880-dsi/fifo - FIFO_STATUS of both links, clear the sticky flags, re-read after 100 ms.
+ * A flag that comes back means the overflow/underflow is ongoing, not a start-up transient. */
+static int u880_fifo_show(struct seq_file *m, void *unused)
+{
+	u32 before[2], after[2];
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		if (!u880_hosts[i])
+			return -ENODEV;
+		before[i] = dsi_read(u880_hosts[i], REG_DSI_FIFO_STATUS);
+		dsi_write(u880_hosts[i], REG_DSI_FIFO_STATUS, before[i]);
+	}
+	msleep(100);
+	for (i = 0; i < 2; i++)
+		after[i] = dsi_read(u880_hosts[i], REG_DSI_FIFO_STATUS);
+	for (i = 0; i < 2; i++)
+		seq_printf(m, "dsi%d before=%08x after100ms=%08x\n", i, before[i], after[i]);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(u880_fifo);
+
+static void dsi_u880_reset_link(struct msm_dsi_host *h, u32 ctrl)
+{
+	void __iomem *phy = ioremap(h->id ? 0xae97000 : 0xae95000, 0x200);
+	int i;
+
+	dsi_write(h, REG_DSI_CTRL, ctrl & ~DSI_CTRL_VID_MODE_EN);
+	wmb();
+	dsi_write(h, REG_DSI_CTRL, ctrl & ~(DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN));
+	wmb();
+	dsi_write(h, REG_DSI_CLK_CTRL, DSI_CLK_CTRL_ENABLE_CLKS);
+	dsi_write(h, REG_DSI_RESET, 1);
+	wmb();
+	dsi_write(h, REG_DSI_RESET, 0);
+	wmb();
+	dsi_write(h, REG_DSI_CTRL, ctrl & ~DSI_CTRL_VID_MODE_EN);
+	wmb();
+	if (!phy)
+		return;
+	for (i = 0; i < 10; i++) {
+		writel(0x1f, phy + 0xac);	/* CMN_LANE_CTRL3 */
+		wmb();
+		udelay(200);
+		if (readl(phy + 0x14c) == 0x1f)	/* CMN_LANE_STATUS1 */
+			break;
+	}
+	writel(0, phy + 0xac);
+	wmb();
+	iounmap(phy);
+}
+
+static void dsi_u880_video_fifo_recover(struct msm_dsi_host *msm_host)
+{
+	const u32 run = DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN;
+	struct msm_dsi_host *h;
+	void __iomem *intf;
+	u32 ctrl[2] = {}, line = 0;
+	int i, n;
+
+	if (!mutex_trylock(&u880_recover_lock))
+		return;	/* the other link's worker is already recovering both */
+	for (i = 0; i < 2; i++) {
+		h = u880_hosts[i];
+		if (!h || !h->power_on || !h->enabled)
+			goto out;
+	}
+	for (i = 0; i < 2; i++) {
+		ctrl[i] = dsi_read(u880_hosts[i], REG_DSI_CTRL) | run;
+		dsi_u880_reset_link(u880_hosts[i], ctrl[i]);
+	}
+	/* vendor: wait for the display line count to be in the active area (INTF1 LINE_COUNT, vsw+vbp = 100 lines) */
+	intf = ioremap(0xae36000, 0x100);
+	for (n = 0; intf && n < 400; n++) {
+		line = readl(intf + 0xb0) & 0xffff;
+		if (line > 120 && line < 2400)
+			break;
+		usleep_range(50, 100);
+	}
+	if (intf)
+		iounmap(intf);
+	for (i = 0; i < 2; i++) {
+		dsi_write(u880_hosts[i], REG_DSI_CTRL, ctrl[i]);
+		wmb();
+	}
+	for (i = 0; i < 2; i++)
+		dsi_write(u880_hosts[i], REG_DSI_FIFO_STATUS, dsi_read(u880_hosts[i], REG_DSI_FIFO_STATUS));
+	pr_info_ratelimited("DSI: both links recovered (INTF1 line %u)\n", line);
+out:
+	mutex_unlock(&u880_recover_lock);
+}

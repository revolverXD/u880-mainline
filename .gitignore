# Whitelist: only our own sources and notes. Kernel tree, build output, images, vendor firmware and private keys stay out.
/*
!/.gitignore
!/NOTES.md
!/FINDINGS.md
!/scripts/
!/patches/
!/kernel/
!/topology/
!/ucm/
!/tools/
!/stock-dt/
!/stage1/
/stage1/*
!/stage1/*.dtso
!/stage1/initramfs/
!/usb/
!/power/
!/tablet-rootfs/
!/sensors/
/sensors/vendor/
/sensors/persist/
/sensors/stage/
*.o
*.ko
*.mod
*.mod.c
*.cmd
modules.order
Module.symvers
.tmp_versions/

# vendor/device sensor data (stock vendor.img configs, persist registry/calibration): local only, not redistributable
sensors/vendor/
sensors/persist/
sensors/stage/
!/dts/
